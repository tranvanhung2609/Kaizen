# =========================================================
# SUPABASE
# =========================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key


# =========================================================
# DATABASE
# =========================================================

# Runtime (Next.js / Drizzle runtime)
# Transaction Pooler
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Migration (Drizzle Kit)
# Session Pooler hoặc Direct Connection
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require